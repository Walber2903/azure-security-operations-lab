// Lab 16 - Validate scheduled-task Event 4698 ingestion and measure delay.

Event
| where TimeGenerated > ago(2h)
| where Computer startswith "vm-win-cac-01"
| where EventLog == "Security"
| where EventID == 4698
| extend IngestionTime = ingestion_time()
| extend IngestionDelay = IngestionTime - TimeGenerated
| project
    TimeGenerated,
    IngestionTime,
    IngestionDelay,
    Computer,
    EventID,
    RenderedDescription
| order by TimeGenerated desc
