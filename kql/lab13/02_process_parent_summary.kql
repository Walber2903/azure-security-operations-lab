// Lab 13 - Parent Process and Command-Line Visibility Summary
// Purpose: summarize command-interpreter executions and expose missing command-line telemetry.

Event
| where EventID == 4688
| extend
    SubjectUserName = extract(@"<Data Name=""SubjectUserName"">([^<]*)</Data>", 1, EventData),
    NewProcessName = extract(@"<Data Name=""NewProcessName"">([^<]*)</Data>", 1, EventData),
    CommandLine = extract(@"<Data Name=""CommandLine"">([^<]*)</Data>", 1, EventData),
    ParentProcessName = extract(@"<Data Name=""ParentProcessName"">([^<]*)</Data>", 1, EventData)
| where NewProcessName endswith @"\powershell.exe"
    or NewProcessName endswith @"\cmd.exe"
| extend CommandLineAvailable = iff(isempty(CommandLine), "No", "Yes")
| summarize
    Executions = count()
    by SubjectUserName, ParentProcessName, CommandLineAvailable
| order by Executions desc
