// Lab 13 - Controlled PowerShell Validation Event
// Purpose: find the controlled LAB13-HUNT-TEST execution after command-line auditing was enabled.

Event
| where EventID == 4688
| extend
    SubjectUserName = extract(@"<Data Name=""SubjectUserName"">([^<]*)</Data>", 1, EventData),
    SubjectUserSid  = extract(@"<Data Name=""SubjectUserSid"">([^<]*)</Data>", 1, EventData),
    NewProcessName  = extract(@"<Data Name=""NewProcessName"">([^<]*)</Data>", 1, EventData),
    CommandLine     = extract(@"<Data Name=""CommandLine"">([^<]*)</Data>", 1, EventData),
    ParentProcessName = extract(@"<Data Name=""ParentProcessName"">([^<]*)</Data>", 1, EventData),
    ProcessId       = extract(@"<Data Name=""ProcessId"">([^<]*)</Data>", 1, EventData),
    NewProcessId    = extract(@"<Data Name=""NewProcessId"">([^<]*)</Data>", 1, EventData)
| where NewProcessName endswith @"\powershell.exe"
| where CommandLine contains "LAB13-HUNT-TEST"
| project TimeGenerated, Computer, SubjectUserName, SubjectUserSid,
          ParentProcessName, NewProcessName, CommandLine, ProcessId, NewProcessId
| extend Host_0_HostName = Computer
| extend Account_0_Name = SubjectUserName
| order by TimeGenerated desc
